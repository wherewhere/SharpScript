<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CompressionEnabled>false</CompressionEnabled>
    <Features>runtime-async=on</Features>
    <IsTrimmable>true</IsTrimmable>
    <NoWarn>$(NoWarn);CA1873;VSTHRD103</NoWarn>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <RunNPMCompilation>true</RunNPMCompilation>
    <TargetFramework>net11.0-browser</TargetFramework>
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
    <PackageReference Include="ILAssembler" Version="11.0.0-build.10.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.14.0-1.26527.7" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.14.0-1.26527.7" />
    <PackageReference Include="Mobius.ILasm" Version="0.1.0" />
    <PackageReference Include="System.Security.Permissions" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(NetCoreRoot)\sdk\$(NETCoreSdkVersion)\Sdks\Microsoft.NET.Sdk\analyzers\*.dll" Aliases="Analyzers" />
    <Reference Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\$(BundledNETCoreAppPackageVersion)\analyzers\dotnet\cs\*.dll" Aliases="AnalyzersCSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\PatchCoreLib.targets.cs" />
    <None Include="Properties\PatchCoreLib.targets.cs" />
  </ItemGroup>

  <Target Name="NPMRestore" AfterTargets="Restore">
    <Exec Command="npm install" WorkingDirectory="Site" />
  </Target>

  <Target Name="NPMBuild" BeforeTargets="PreBuildEvent" Condition="$(RunNPMCompilation) == 'true'">
    <ItemGroup>
      <Content Remove="wwwroot/assets/**/*" />
    </ItemGroup>
    <Exec Command="npm run build" WorkingDirectory="Site" />
    <ItemGroup>
      <Content Include="wwwroot/assets/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="GetFrameworkXmlDocumentation" AfterTargets="ResolveReferences">
    <ItemGroup>
      <Content Include="@(Reference->'%(RootDir)%(Directory)%(Filename).xml')" Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" Link="wwwroot/_framework/%(Filename).xml">
      </Content>
    </ItemGroup>
  </Target>

  <Import Project="Properties\PatchCoreLib.targets" />

</Project>
